{
  "name": "anklebreaker-unity-mcp",
  "version": "5.0.0",
  "description": "Composable Unity MCP server with a bounded bootstrap, searchable canonical catalog, exact typed-tool activation, stable stdio, and instance binding.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "unity-mcp": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js",
    "test": "node scripts/sync-manifest-tools.mjs --check && node --test tests/*.test.mjs",
    "audit:tools": "node scripts/audit-tool-architecture.mjs",
    "sync:manifest-tools": "node scripts/sync-manifest-tools.mjs",
    "test:live": "node tests/live-unity-tool-refresh.mjs",
    "test:multi-instance": "node tests/live-unity-multi-instance-binding.mjs",
    "test:error-propagation": "node tests/live-unity-error-propagation.mjs",
    "test:package-job-reload": "node tests/live-unity-package-job-reload.mjs",
    "test:refresh-recovery": "node tests/live-unity-asset-refresh-recovery.mjs",
    "test:refresh-job-reload": "node tests/live-unity-refresh-job-reload.mjs",
    "test:reload": "node tests/live-unity-reload-replay.mjs",
    "test:server-hot-reload": "node --test tests/hot-reload-proxy.test.mjs",
    "pack": "npx @anthropic-ai/mcpb pack . unity-mcp.mcpb && npx @anthropic-ai/mcpb clean unity-mcp.mcpb"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=18.0.0"
  }
}
